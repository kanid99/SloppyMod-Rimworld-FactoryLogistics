<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    ============================================================ air supply

    The compressor makes 10 L each network tick and every station leaks 1, so one compressor
    carries a handful of stations and still refills the tanks. A launch takes 30 L (scaled by the capsule's weight: half empty, 1.5x full) out of the
    tanks in one go (TubeStationExtension on the sender), which is three network ticks - five
    seconds - of one compressor's output.

    producerLowPowerWhenStorageFull is the framework's own switch: while every tank on the
    network is full the compressor drops to idlePowerDraw, and the moment a launch leaves them
    short it goes back to full power until they are full again. That is the burst.
  -->
  <ThingDef ParentName="BuildingBase">
    <defName>FL_Compressor</defName>
    <label>air compressor</label>
    <description>Pressurises a pneumatic tube network. It idles on very little power while the network's air tanks are full, and runs flat out to refill them after each capsule is sent. With no power, or broken down, the network loses pressure and its stations stop sending and receiving.\n\nNeeds at least one air tank on the same tubes: capsules are fired with air from the tanks.</description>
    <graphicData>
      <texPath>Things/Building/FactoryLogistics/Compressor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.3</staticSunShadowHeight>
    <canOverlapZones>false</canOverlapZones>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Mass>40</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>-8</Beauty>
    </statBases>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>300</basePowerConsumption>
        <idlePowerDraw>40</idlePowerDraw>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="PipeSystem.CompProperties_ResourceTrader">
        <pipeNet>FL_AirNet</pipeNet>
        <consumptionPerTick>-10</consumptionPerTick>
        <producerLowPowerWhenStorageFull>true</producerLowPowerWhenStorageFull>
      </li>
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Production</designationCategory>
    <constructEffect>ConstructMetal</constructEffect>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>FL_PneumaticTubes</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>FL_AirTank</defName>
    <label>air tank</label>
    <description>Stores compressed air for a pneumatic tube network. Every capsule sent takes a burst of air from the tanks, so the number of tanks decides how many capsules can go in quick succession before the stations have to wait for the compressor to catch up.</description>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/FactoryLogistics/AirTank</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.3</staticSunShadowHeight>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>0.2</Flammability>
      <Beauty>-4</Beauty>
    </statBases>
    <costList>
      <Steel>60</Steel>
    </costList>
    <comps>
      <li Class="PipeSystem.CompProperties_ResourceStorage">
        <pipeNet>FL_AirNet</pipeNet>
        <storageCapacity>150</storageCapacity>
        <addTransferGizmo>false</addTransferGizmo>
        <barSize>(0.62, 0.12)</barSize>
        <margin>0.03</margin>
        <centerOffset>(0, 0, -0.3)</centerOffset>
      </li>
    </comps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Production</designationCategory>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>FL_PneumaticTubes</li>
    </researchPrerequisites>
  </ThingDef>

  <!--
    ============================================================ stations

    Both kinds are storage buildings, which is the whole trick: a pack bill is told to "take to"
    a sender exactly as it would be told to take to a shelf, the pawn who packed the capsule
    carries it there as the last step of the bill, and an unpack bill's ordinary ingredient
    search finds delivered capsules sitting in a receiver. There are no custom jobs.

    The filters here say only "packed capsules" or "delivered capsules". The rest of the rule -
    a sender takes only capsules addressed to it, a receiver takes nothing from haulers at all -
    is in FactoryLogistics.Building_TubeStation.

    groupingLabel must be set: the bill dialog files storage buildings under it and a null one
    is an exception there.

    A station's capacity is its cells times maxItemsInCell.
  -->
  <ThingDef Name="FL_StationBase" ParentName="BuildingBase" Abstract="True">
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.4</staticSunShadowHeight>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <inspectorTabs>
      <li>ITab_Storage</li>
    </inspectorTabs>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Production</designationCategory>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>FL_PneumaticTubes</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="FL_StationBase">
    <defName>FL_Sender</defName>
    <label>tube sender</label>
    <description>The way into a pneumatic tube network. Point it at one tube receiver on the same tubes, then set a packing bench's bills to take their capsules to it: each capsule that arrives is fired down the tube as soon as there is air in the tanks and room at the other end.\n\nIt only takes capsules addressed to it. Bills address their capsules to the sender they are set to take them to; any other capsule can be addressed by selecting it.</description>
    <thingClass>FactoryLogistics.Building_TubeSender</thingClass>
    <graphicData>
      <texPath>Things/Building/FactoryLogistics/Sender</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Mass>15</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <!-- One being sent and one waiting, so a packer is not turned away mid-launch. -->
      <maxItemsInCell>2</maxItemsInCell>
      <groupingLabel>tube senders</groupingLabel>
      <groupingOrder>30</groupingOrder>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>FL_Capsule</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>FL_Capsule</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
    <comps>
      <li Class="PipeSystem.CompProperties_ResourceTrader">
        <pipeNet>FL_AirNet</pipeNet>
        <consumptionPerTick>1</consumptionPerTick>
      </li>
    </comps>
    <modExtensions>
      <li Class="FactoryLogistics.TubeStationExtension">
        <launchAirCost>30</launchAirCost>
        <transitTicksPerCell>2</transitTicksPerCell>
        <minTransitTicks>30</minTransitTicks>
        <maxTransitTicks>900</maxTransitTicks>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef Name="FL_ReceiverBase" ParentName="FL_StationBase" Abstract="True">
    <thingClass>FactoryLogistics.Building_TubeReceiver</thingClass>
    <comps>
      <li Class="PipeSystem.CompProperties_ResourceTrader">
        <pipeNet>FL_AirNet</pipeNet>
        <consumptionPerTick>1</consumptionPerTick>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="FL_ReceiverBase">
    <defName>FL_Receiver</defName>
    <label>tube receiver</label>
    <description>The way out of a pneumatic tube network. Any number of tube senders can point at it. Capsules arrive here and wait to be opened by an unpack bill at a packing bench nearby.\n\nHolds two capsules. When it is full, the senders pointed at it wait.</description>
    <graphicData>
      <texPath>Things/Building/FactoryLogistics/Receiver</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Mass>12</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>40</Steel>
    </costList>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <maxItemsInCell>2</maxItemsInCell>
      <groupingLabel>tube receivers</groupingLabel>
      <groupingOrder>31</groupingOrder>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>FL_CapsuleDelivered</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>FL_CapsuleDelivered</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
  </ThingDef>

  <ThingDef ParentName="FL_ReceiverBase">
    <defName>FL_ReceiverRack</defName>
    <label>tube receiver rack</label>
    <description>A tube receiver with a rack behind it. It does the same job as the small receiver and holds eight capsules, for kitchens, workshops and anywhere else that several senders feed or that is not unpacked the moment something arrives.</description>
    <graphicData>
      <texPath>Things/Building/FactoryLogistics/ReceiverRack</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,2)</drawSize>
    </graphicData>
    <size>(1,2)</size>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>2000</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>90</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <building>
      <preventDeteriorationOnTop>true</preventDeteriorationOnTop>
      <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
      <maxItemsInCell>4</maxItemsInCell>
      <groupingLabel>tube receivers</groupingLabel>
      <groupingOrder>31</groupingOrder>
      <fixedStorageSettings>
        <filter>
          <thingDefs>
            <li>FL_CapsuleDelivered</li>
          </thingDefs>
        </filter>
      </fixedStorageSettings>
      <defaultStorageSettings>
        <priority>Important</priority>
        <filter>
          <thingDefs>
            <li>FL_CapsuleDelivered</li>
          </thingDefs>
        </filter>
      </defaultStorageSettings>
    </building>
  </ThingDef>

  <!--
    ============================================================ packing bench

    A plain work table. Its bills are in Recipes_Tubes.xml (they name this bench in recipeUsers)
    and the work giver that sends pawns to it is in WorkGivers_Tubes.xml. It needs no power and
    no air: it can stand anywhere, including somewhere the tubes do not reach.
  -->
  <ThingDef ParentName="BenchBase">
    <defName>FL_PackingBench</defName>
    <label>packing bench</label>
    <description>A bench for packing goods into pneumatic tube capsules and for unpacking capsules that have arrived. Give it a pack bill for each kind of thing to send, set to take its capsules to a tube sender, and an unpack bill wherever a tube receiver delivers.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/FactoryLogistics/PackingBench</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,1)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <size>(2,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Flammability>0.8</Flammability>
    </statBases>
    <costList>
      <Steel>60</Steel>
    </costList>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <designationCategory>Production</designationCategory>
    <constructEffect>ConstructMetal</constructEffect>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>FL_PneumaticTubes</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
