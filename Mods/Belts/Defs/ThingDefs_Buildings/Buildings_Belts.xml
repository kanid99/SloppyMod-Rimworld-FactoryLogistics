<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The belts module. Loaded only when Vanilla Furniture Expanded - Factory is active
    (LoadFolders.xml), so these defs may name its classes, research and build tab freely.

    The arm is not an edifice: it sits on the floor beside a belt, like a conduit, so a VFE belt
    that points at it drops its item onto it, and pawns walk over it.
  -->
  <ThingDef ParentName="BuildingBase">
    <defName>FL_ConveyorArm</defName>
    <label>conveyor arm</label>
    <description>A powered arm that works a Vanilla Furniture Expanded - Factory belt line. Its gripper reaches into the cell it takes from, and it puts down on the cell behind it. A button switches it between two jobs:\n\nLoader: gripper towards a stockpile, shelf or other storage, a conveyor behind it. It puts goods onto the belt.\n\nFeeder: gripper towards the end of a belt, with a machine's input behind it - a VFE factory machine's input hopper or conveyor, the SloppyMods repair centre's item spot, or any storage. It takes what the belt brings and puts it in.\n\nTogether they form a network: the Feeder reads what its machine still needs (for a VFE machine, its current process; for the repair centre, gear its filters would take; for storage, what its settings allow while it has room), and every Loader on the belts leading to it sends only that - no more than is missing, counting what is already on its way. Anything that reaches the Feeder and is no longer wanted is set down on the floor beside it, so the line never jams.</description>
    <thingClass>FactoryLogistics.Belts.Building_LogisticsArm</thingClass>
    <graphicData>
      <texPath>Things/Building/FactoryLogistics/ArmLoader</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>UI/Commands/FactoryLogistics/ArmLoader</uiIconPath>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <tickerType>Normal</tickerType>
    <canOverlapZones>true</canOverlapZones>
    <clearBuildingArea>false</clearBuildingArea>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Mass>12</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <relatedBuildCommands>
        <li>VFEFactory_Conveyor</li>
        <li>VFEFactory_FactoryHopper</li>
      </relatedBuildCommands>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>60</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <designationCategory>VFEFactory_Factories</designationCategory>
    <researchPrerequisites>
      <li>VFE_BasicFactories</li>
    </researchPrerequisites>
    <constructEffect>ConstructMetal</constructEffect>
  </ThingDef>

  <!--
    The conveyor lift: a belt drops items onto it and its partner puts them onto the belt in
    front of the partner. With As above, So below it pairs by itself with the lift on the same
    spot a level up or down; otherwise (or to override) it is linked by hand.
  -->
  <ThingDef ParentName="BuildingBase">
    <defName>FL_ConveyorLift</defName>
    <label>conveyor lift</label>
    <description>Carries belt items between two lifts. Point a conveyor belt at a lift and it drops its items onto it; the lift's partner puts them onto the conveyor in front of the partner, one about every second. Lifts work both ways and their facing is the side they put out on.

With "As above, So below" installed, a lift pairs by itself with a lift built on the same spot one level up (or, if there is none, one level down) - a conveyor elevator. Any two lifts can also be linked by hand, which overrides that and works as a long-distance belt link without that mod.

Conveyor arm networks follow belts through lifts, so a Loader on one level can serve a Feeder on another.</description>
    <thingClass>FactoryLogistics.Belts.Building_ConveyorLift</thingClass>
    <graphicData>
      <texPath>Things/Building/FactoryLogistics/ConveyorLift</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>UI/Commands/FactoryLogistics/ConveyorLift</uiIconPath>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <tickerType>Normal</tickerType>
    <canOverlapZones>true</canOverlapZones>
    <clearBuildingArea>false</clearBuildingArea>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Mass>20</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <relatedBuildCommands>
        <li>VFEFactory_Conveyor</li>
        <li>FL_ConveyorArm</li>
      </relatedBuildCommands>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>100</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <designationCategory>VFEFactory_Factories</designationCategory>
    <researchPrerequisites>
      <li>VFE_BasicFactories</li>
    </researchPrerequisites>
    <constructEffect>ConstructMetal</constructEffect>
  </ThingDef>

  <!--
    The belt junction: a trunk belt drops onto it, and it passes each item onto the branch belt
    (one of its other sides) whose Feeder's machine wants it.
  -->
  <ThingDef ParentName="BuildingBase">
    <defName>FL_BeltJunction</defName>
    <label>belt junction</label>
    <description>Splits one supply belt between several factory machines. Point the supply belt (the trunk) at the junction, and run belts away from its other sides, each ending at a conveyor arm Feeder for a machine.

Loaders on the trunk send what all those machines still lack, and the junction passes each item onto the branch that wants it: the Feeder with the highest priority first, then whichever was served longest ago. An item no machine wants any more is set down beside the junction, so the trunk never jams; one a branch wants but has no room for yet waits on the junction.</description>
    <thingClass>FactoryLogistics.Belts.Building_BeltJunction</thingClass>
    <graphicData>
      <texPath>Things/Building/FactoryLogistics/BeltJunction</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconPath>UI/Commands/FactoryLogistics/BeltJunction</uiIconPath>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <canOverlapZones>true</canOverlapZones>
    <clearBuildingArea>false</clearBuildingArea>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>1400</WorkToBuild>
      <Mass>15</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <relatedBuildCommands>
        <li>VFEFactory_Conveyor</li>
        <li>FL_ConveyorArm</li>
      </relatedBuildCommands>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <designationCategory>VFEFactory_Factories</designationCategory>
    <researchPrerequisites>
      <li>VFE_BasicFactories</li>
    </researchPrerequisites>
    <constructEffect>ConstructMetal</constructEffect>
  </ThingDef>

</Defs>
